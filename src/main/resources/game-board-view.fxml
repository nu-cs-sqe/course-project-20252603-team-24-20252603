<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="gui.GameBoardController"
        style="-fx-background-color: #87ceeb;">

    <center>
        <WebView fx:id="mapView" />
    </center>

    <right>
        <VBox
                prefWidth="260.0"
                spacing="10.0"
                style="-fx-background-color: #d8efff; -fx-border-color: #4b8eb8; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets top="14" bottom="14" left="14" right="14" />
            </padding>

            <Label text="%board.cards"
                   style="-fx-text-fill: #376b8d; -fx-font-size: 10px; -fx-font-weight: bold;" />
            <ListView fx:id="cardListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #fbfdff; -fx-control-inner-background: #fbfdff; -fx-text-fill: #24313d;" />
            <Button fx:id="tradeCardsButton" text="%board.tradeCards" onAction="#handleTradeCards"
                    maxWidth="Infinity"
                    style="-fx-background-color: #d6a84f; -fx-text-fill: #17202a; -fx-font-weight: bold;" />
        </VBox>
    </right>

    <bottom>
        <VBox
                spacing="10.0"
                style="-fx-background-color: #1f5f8b; -fx-border-color: #174765; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="10" bottom="10" left="16" right="16" />
            </padding>

            <HBox spacing="24.0" alignment="CENTER_LEFT">
                <VBox spacing="2.0">
                    <Label text="%board.phase" style="-fx-text-fill: #b9d8ec; -fx-font-size: 9px; -fx-font-weight: bold;" />
                    <Label fx:id="phaseLabel" text=""
                           style="-fx-text-fill: #f5fbff; -fx-font-size: 13px; -fx-font-weight: bold;" />
                </VBox>

                <Region prefWidth="1.0" style="-fx-background-color: #4b8eb8;" prefHeight="36.0" />

                <VBox spacing="2.0">
                    <Label text="%board.currentPlayer" style="-fx-text-fill: #b9d8ec; -fx-font-size: 9px; -fx-font-weight: bold;" />
                    <Label fx:id="playerLabel" text="—"
                           style="-fx-text-fill: #f5fbff; -fx-font-size: 13px; -fx-font-weight: bold;" />
                </VBox>

                <Region prefWidth="1.0" style="-fx-background-color: #4b8eb8;" prefHeight="36.0" />

                <VBox spacing="2.0">
                    <Label text="%board.armiesToPlace" style="-fx-text-fill: #b9d8ec; -fx-font-size: 9px; -fx-font-weight: bold;" />
                    <Label fx:id="armiesLabel" text="—"
                           style="-fx-text-fill: #f5fbff; -fx-font-size: 13px; -fx-font-weight: bold;" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="statusLabel" text="%status.clickToBegin"
                       style="-fx-text-fill: #d7edf8; -fx-font-size: 12px; -fx-font-style: italic;" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="%board.captureArmies" style="-fx-text-fill: #d7edf8; -fx-font-size: 12px;" />
                <Spinner fx:id="captureArmiesSpinner" prefWidth="72.0" />
                <Button fx:id="moveAfterCaptureButton" text="%board.move" onAction="#handleMoveAfterCapture" />
                <Button fx:id="endAttackButton" text="%board.endAttack" onAction="#handleEndAttack" />

                <Region prefWidth="1.0" style="-fx-background-color: #4b8eb8;" prefHeight="30.0" />

                <Label text="%board.fortifyArmies" style="-fx-text-fill: #d7edf8; -fx-font-size: 12px;" />
                <Spinner fx:id="fortifyArmiesSpinner" prefWidth="72.0" />
                <Button fx:id="fortifyButton" text="%board.fortify" onAction="#handleFortify" />
                <Button fx:id="endTurnButton" text="%board.endTurn" onAction="#handleEndTurn" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
