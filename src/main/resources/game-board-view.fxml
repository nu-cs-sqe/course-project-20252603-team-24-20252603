<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="gui.GameBoardController"
        style="-fx-background-color: #e8f5ff;">

    <center>
        <WebView fx:id="mapView" />
    </center>

    <right>
        <VBox
                prefWidth="260.0"
                spacing="10.0"
                style="-fx-background-color: #f4fbff; -fx-border-color: #b8d8ed; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets top="14" bottom="14" left="14" right="14" />
            </padding>

            <Label text="CARDS"
                   style="-fx-text-fill: #376b8d; -fx-font-size: 10px; -fx-font-weight: bold;" />
            <ListView fx:id="cardListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #fbfdff; -fx-control-inner-background: #fbfdff; -fx-text-fill: #24313d;" />
            <Button fx:id="tradeCardsButton" text="Trade Cards" onAction="#handleTradeCards"
                    maxWidth="Infinity"
                    style="-fx-background-color: #d6a84f; -fx-text-fill: #17202a; -fx-font-weight: bold;" />
        </VBox>
    </right>

    <bottom>
        <VBox
                spacing="10.0"
                style="-fx-background-color: #f4fbff; -fx-border-color: #b8d8ed; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="10" bottom="10" left="16" right="16" />
            </padding>

            <HBox spacing="24.0" alignment="CENTER_LEFT">
                <VBox spacing="2.0">
                    <Label text="PHASE" style="-fx-text-fill: #376b8d; -fx-font-size: 9px; -fx-font-weight: bold;" />
                    <Label fx:id="phaseLabel" text="SCRAMBLE"
                           style="-fx-text-fill: #26323c; -fx-font-size: 13px; -fx-font-weight: bold;" />
                </VBox>

                <Region prefWidth="1.0" style="-fx-background-color: #b8d8ed;" prefHeight="36.0" />

                <VBox spacing="2.0">
                    <Label text="CURRENT PLAYER" style="-fx-text-fill: #376b8d; -fx-font-size: 9px; -fx-font-weight: bold;" />
                    <Label fx:id="playerLabel" text="—"
                           style="-fx-text-fill: #26323c; -fx-font-size: 13px; -fx-font-weight: bold;" />
                </VBox>

                <Region prefWidth="1.0" style="-fx-background-color: #b8d8ed;" prefHeight="36.0" />

                <VBox spacing="2.0">
                    <Label text="ARMIES TO PLACE" style="-fx-text-fill: #376b8d; -fx-font-size: 9px; -fx-font-weight: bold;" />
                    <Label fx:id="armiesLabel" text="—"
                           style="-fx-text-fill: #26323c; -fx-font-size: 13px; -fx-font-weight: bold;" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="statusLabel" text="Click a territory to begin."
                       style="-fx-text-fill: #5f6c78; -fx-font-size: 12px; -fx-font-style: italic;" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Capture armies" style="-fx-text-fill: #5f6c78; -fx-font-size: 12px;" />
                <Spinner fx:id="captureArmiesSpinner" prefWidth="72.0" />
                <Button fx:id="moveAfterCaptureButton" text="Move" onAction="#handleMoveAfterCapture" />
                <Button fx:id="endAttackButton" text="End Attack" onAction="#handleEndAttack" />

                <Region prefWidth="1.0" style="-fx-background-color: #b8d8ed;" prefHeight="30.0" />

                <Label text="Fortify armies" style="-fx-text-fill: #5f6c78; -fx-font-size: 12px;" />
                <Spinner fx:id="fortifyArmiesSpinner" prefWidth="72.0" />
                <Button fx:id="fortifyButton" text="Fortify" onAction="#handleFortify" />
                <Button fx:id="endTurnButton" text="End Turn" onAction="#handleEndTurn" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
